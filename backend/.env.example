# Ambiente
ENVIRONMENT=development
PROJECT_NAME="Vevey Doces API"

# Conexão PostgreSQL (Supabase ou Local)
# No Supabase: Session Pooler (porta 5432) ou Transaction Pooler (porta 6543)
DATABASE_URL=postgresql://postgres.seu-projeto:[SUA-SENHA]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Segurança JWT
SECRET_KEY=sua_chave_secreta_super_segura_aqui_para_tcc_vevey
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# CORS (origens permitidas do frontend)
BACKEND_CORS_ORIGINS=["http://localhost:5500","http://127.0.0.1:5500","http://localhost:3000","https://vevey.vercel.app"]
